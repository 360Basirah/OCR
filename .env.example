ENV=development
HOST=127.0.0.1
PORT=8090

# Required shared secret — must match Basirah PADDLEOCR_API_KEY
OCR_API_KEY=change-me-to-a-long-random-secret

# GPU (RTX 4060 / RunPod). Use cpu only for debugging — VL is slow on CPU.
PADDLEOCR_DEVICE=gpu:0
PADDLEOCR_VL_PIPELINE_VERSION=v1.6

# How many OCR jobs may use the GPU at once (1 = fair queue; A finishes before B runs).
PADDLEOCR_MAX_CONCURRENT=1

# Doc unwarping improves accuracy on skewed phone scans (IDs/passports).
PADDLEOCR_USE_DOC_UNWARPING=true

# PP-StructureV3 language (en recommended for English financials / IDs).
PADDLEOCR_STRUCTURE_LANG=en

# Warm engines at startup (set false to skip unused pipelines and save VRAM/boot time).
PADDLEOCR_WARM_VL=true
PADDLEOCR_WARM_OCR=true
PADDLEOCR_WARM_STRUCTURE=true

# VL recognition backend. Leave empty for in-process Paddle (no Docker).
# For faster decoding with a local vLLM container (see vllm_config.yml + README):
#   PADDLEOCR_VL_REC_BACKEND=vllm-server
#   PADDLEOCR_VL_REC_SERVER_URL=http://localhost:8118/v1
PADDLEOCR_VL_REC_BACKEND=
PADDLEOCR_VL_REC_SERVER_URL=

# vLLM server URL
PADDLEOCR_VL_REC_BACKEND=vllm-server
PADDLEOCR_VL_REC_SERVER_URL=http://localhost:8118/v1

# Raise for local Postman parallel tests if you hit 429s
RATE_LIMIT_OCR=30/minute
RATE_LIMIT_OCR_TABLE=15/minute
RATE_LIMIT_GLOBAL=60/minute
MAX_UPLOAD_BYTES=10485760
# Include host.docker.internal when Basirah API runs in Docker
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
