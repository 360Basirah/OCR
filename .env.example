ENV=development
HOST=127.0.0.1
PORT=8090

# Required shared secret — must match Basirah PADDLEOCR_API_KEY
OCR_API_KEY=change-me-to-a-long-random-secret

# GPU (RTX 4060 / RunPod). Use cpu only for debugging — VL is slow on CPU.
PADDLEOCR_DEVICE=gpu:0
PADDLEOCR_VL_PIPELINE_VERSION=v1.6

RATE_LIMIT_OCR=30/minute
RATE_LIMIT_OCR_TABLE=15/minute
RATE_LIMIT_GLOBAL=60/minute
MAX_UPLOAD_BYTES=10485760
# Include host.docker.internal when Basirah API runs in Docker
ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
